{
  "name": "chunk-your-tools",
  "version": "2.3.9",
  "description": "TypeScript SDK for chunk-your-tools — tool schema decomposition and recomposition",
  "keywords": [
    "mcp",
    "json-schema",
    "tool-gating",
    "chunk-your-tools"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qdrddr/chunk-your-tools.git",
    "directory": "sdk/typescript"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "Damien Berezenko",
    "linkedin": "https://www.linkedin.com/in/damien-e"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "native.cjs",
    "native.d.ts",
    "chunk-your-tools.*.node",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "npm run build:native && npm run build:js",
    "build:js": "tsc",
    "build:native": "bash ../../scripts/local/dev/napi-build.sh",
    "test": "npm run build && node --test dist/test/*.test.js"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.8.2",
    "@types/node": "^26.1.2",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20"
  },
  "napi": {
    "binaryName": "chunk-your-tools",
    "targets": [
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-pc-windows-msvc",
      "aarch64-pc-windows-msvc",
      "x86_64-apple-darwin",
      "aarch64-apple-darwin"
    ]
  }
}
